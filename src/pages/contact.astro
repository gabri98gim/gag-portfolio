---
import Layout from "../layouts/Layout.astro";
import { FaLinkedinIn, FaGithub } from "react-icons/fa6";

const socialLinks = [
  {
    href: "https://www.linkedin.com/in/gabriel-andreu-gimeno-ba674824a/",
    icon: FaLinkedinIn,
    label: "LinkedIn",
  },
  { href: "https://github.com/gabri98gim", icon: FaGithub, label: "GitHub" },
];
---

<Layout>
  <section
    class="min-h-screen flex items-center justify-center px-4 pt-28 pb-12 relative overflow-hidden"
  >
    <!-- Background orbs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div
        class="absolute top-0 left-1/4 w-96 h-96 bg-(--color-primary) opacity-[0.06] rounded-full blur-[120px] animate-gradientMove"
      >
      </div>
      <div
        class="absolute top-0 right-1/4 w-96 h-96 bg-(--color-secondary) opacity-[0.06] rounded-full blur-[120px] animate-gradientMove2"
      >
      </div>
      <div
        class="absolute -bottom-32 left-1/3 w-96 h-96 bg-(--color-primary) opacity-[0.04] rounded-full blur-[120px] animate-gradientMove"
      >
      </div>
    </div>

    <!-- Main card -->
    <div class="relative z-10 w-full max-w-5xl">
      <!-- Glassmorphic split card -->
      <div
        class="contact-glass rounded-2xl shadow-2xl overflow-hidden flex flex-col md:flex-row"
      >
        <!-- ═══════════ LEFT: Info Panel ═══════════ -->
        <div
          class="w-full md:w-5/12 p-6 md:p-8 flex flex-col justify-between relative overflow-hidden"
        >
          <!-- Decorative circle -->
          <div
            class="absolute -top-24 -left-24 w-64 h-64 bg-(--color-primary) opacity-[0.08] rounded-full blur-[80px]"
          >
          </div>

          <div class="relative">
            <h2
              class="text-xs font-bold tracking-[0.25em] text-(--color-primary) uppercase mb-6"
            >
              Contacto
            </h2>
            <h1
              class="text-2xl md:text-3xl font-extrabold leading-tight mb-3 text-(--color-text)"
            >
              CONSTRUYAMOS<br />ALGO
              <span class="text-(--color-primary) relative inline-block">
                ÚNICO
                <svg
                  class="absolute w-full h-3 -bottom-1 left-0 text-(--color-primary) opacity-40"
                  preserveAspectRatio="none"
                  viewBox="0 0 100 10"
                >
                  <path
                    d="M0 5 Q 50 10 100 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></path>
                </svg>
              </span>
            </h1>
            <p
              class="text-(--color-text-muted) text-sm leading-relaxed max-w-sm"
            >
              ¿Listo para transformar tu presencia digital? Combino precisión
              técnica con creatividad audiovisual para crear experiencias
              premium.
            </p>
          </div>

          <div class="relative mt-6 space-y-4">
            <!-- Email -->
            <div class="flex items-start gap-4 group">
              <div
                class="p-3 rounded-lg bg-(--color-card) border border-(--color-border) group-hover:border-(--color-primary) group-hover:bg-(--color-primary)/10 transition-all duration-300"
              >
                <span
                  class="material-icons text-(--color-text-muted) group-hover:text-(--color-primary) transition-colors text-xl"
                  >email</span
                >
              </div>
              <div>
                <p
                  class="text-xs text-(--color-text-muted) uppercase tracking-wider mb-1"
                >
                  Email
                </p>
                <a
                  class="text-(--color-text) hover:text-(--color-primary) transition-colors text-lg font-medium"
                  href="mailto:gandreu8@gmail.com">gandreu8@gmail.com</a
                >
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4 group">
              <div
                class="p-3 rounded-lg bg-(--color-card) border border-(--color-border) group-hover:border-(--color-primary) group-hover:bg-(--color-primary)/10 transition-all duration-300"
              >
                <span
                  class="material-icons text-(--color-text-muted) group-hover:text-(--color-primary) transition-colors text-xl"
                  >location_on</span
                >
              </div>
              <div>
                <p
                  class="text-xs text-(--color-text-muted) uppercase tracking-wider mb-1"
                >
                  Ubicación
                </p>
                <p class="text-(--color-text) text-lg font-medium">
                  Zaragoza, España
                </p>
              </div>
            </div>

            <!-- Social links -->
            <div class="pt-4 border-t border-(--color-border)">
              <p
                class="text-xs text-(--color-text-muted) uppercase tracking-wider mb-4"
              >
                Conecta
              </p>
              <div class="flex gap-5">
                {
                  socialLinks.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-(--color-text-muted) hover:text-(--color-primary) transition-all duration-300 hover:scale-110"
                      aria-label={link.label}
                    >
                      <link.icon className="h-6 w-6" />
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- ═══════════ RIGHT: Form ═══════════ -->
        <div
          class="w-full md:w-7/12 p-6 md:p-8 relative flex flex-col justify-center contact-form-bg"
        >
          <form
            action="https://formspree.io/f/mlgnnzjy"
            method="POST"
            class="space-y-5 relative z-10"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <!-- Name -->
              <div class="group relative">
                <input
                  type="text"
                  name="name"
                  id="contact-name"
                  required
                  placeholder="Tu nombre"
                  class="contact-input peer"
                />
                <label for="contact-name" class="contact-label">TU NOMBRE</label
                >
                <div class="contact-underline"></div>
              </div>

              <!-- Email -->
              <div class="group relative">
                <input
                  type="email"
                  name="email"
                  id="contact-email"
                  required
                  placeholder="tu@email.com"
                  class="contact-input peer"
                />
                <label for="contact-email" class="contact-label">EMAIL</label>
                <div class="contact-underline"></div>
              </div>
            </div>

            <!-- Subject -->
            <div class="group relative">
              <input
                type="text"
                name="subject"
                id="contact-subject"
                required
                placeholder="Asunto"
                class="contact-input peer"
              />
              <label for="contact-subject" class="contact-label">ASUNTO</label>
              <div class="contact-underline"></div>
            </div>

            <!-- Message -->
            <div class="group relative">
              <textarea
                name="message"
                id="contact-message"
                rows="3"
                required
                placeholder=" "
                class="contact-textarea peer"></textarea>
              <label for="contact-message" class="contact-textarea-label"
                >CUÉNTAME TU PROYECTO</label
              >
            </div>

            <!-- Submit -->
            <div class="flex justify-end pt-2">
              <button
                type="submit"
                class="group/btn relative inline-flex items-center justify-center px-8 py-3.5 font-bold text-white transition-all duration-300 bg-(--color-primary) rounded-xl hover:bg-(--color-primary-hover) shadow-[0_0_20px_var(--color-primary)/0.3] hover:shadow-[0_0_30px_var(--color-primary)/0.5] active:scale-95 cursor-pointer"
              >
                <span class="mr-2">Enviar Mensaje</span>
                <span
                  class="material-icons text-sm group-hover/btn:translate-x-1 transition-transform duration-200"
                  >send</span
                >
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Reset form on page show (handles 'Back' button after Formspree redirect)
  window.addEventListener("pageshow", (event) => {
    const form = document.querySelector("form") as HTMLFormElement;
    if (form) {
      form.reset();
    }
  });
</script>

<style>
  /* Glass panel */
  .contact-glass {
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
  }

  .contact-form-bg {
    background-color: var(--color-bg-elevated);
  }

  /* Floating label inputs */
  .contact-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
    color: var(--color-text);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s;
  }

  .contact-input::placeholder {
    color: transparent;
  }

  .contact-input:focus {
    border-color: var(--color-primary);
  }

  .contact-label {
    position: absolute;
    left: 0;
    top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: all 0.3s;
    pointer-events: none;
  }

  .contact-input:focus ~ .contact-label,
  .contact-input:not(:placeholder-shown) ~ .contact-label {
    top: -0.875rem;
    font-size: 0.7rem;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  /* Animated underline */
  .contact-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: width 0.3s;
    box-shadow: 0 0 10px
      color-mix(in srgb, var(--color-primary) 50%, transparent);
  }

  .contact-input:focus ~ .contact-underline {
    width: 100%;
  }

  /* Textarea */
  .contact-textarea {
    width: 100%;
    background-color: color-mix(in srgb, var(--color-card) 40%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem;
    color: var(--color-text);
    font-size: 1rem;
    outline: none;
    resize: none;
    transition: all 0.3s;
  }

  .contact-textarea::placeholder {
    color: transparent;
  }

  .contact-textarea:focus {
    border-color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-card) 60%, transparent);
  }

  .contact-textarea-label {
    position: absolute;
    left: 1rem;
    top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: all 0.3s;
    pointer-events: none;
  }

  .contact-textarea:focus ~ .contact-textarea-label,
  .contact-textarea:not(:placeholder-shown) ~ .contact-textarea-label {
    top: -0.625rem;
    left: 0.75rem;
    font-size: 0.7rem;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    padding: 0 0.25rem;
    background-color: var(--color-bg-elevated);
  }
</style>
