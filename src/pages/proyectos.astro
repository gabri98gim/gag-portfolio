---
import "../styles/projects.css";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/project/proyectCard.astro";

import { proyectos } from "../data/projectData.js";
---

<Layout title="Proyectos" description="Proyectos">
  <main class="max-w-7xl mx-auto px-4 py-16 md:py-24">
    <!-- ═══════════ HEADER ═══════════ -->
    <header class="text-center mb-16 project-fade-in">
      <h2
        class="text-sm font-bold tracking-[0.2em] text-(--color-primary) uppercase mb-3"
      >
        Portfolio
      </h2>
      <div class="relative inline-block">
        <h1
          class="text-4xl md:text-5xl font-extrabold tracking-tight text-(--color-text) mb-2 relative z-10"
        >
          SELECTED WORKS
        </h1>
        <div
          class="absolute -bottom-2 left-0 right-0 h-1.5 bg-(--color-primary) rounded-full transform scale-x-50 origin-center opacity-80"
        >
        </div>
      </div>
      <p class="mt-6 text-(--color-text-muted) max-w-2xl mx-auto">
        Explorando la intersección entre código y storytelling visual.
      </p>
    </header>

    <!-- ═══════════ FILTER TABS ═══════════ -->
    <nav
      class="flex flex-wrap justify-center gap-3 mb-16 project-fade-in"
      style="animation-delay: 0.1s;"
    >
      <button
        class="filter-btn active px-6 py-2.5 rounded-full font-medium transition-all cursor-pointer"
        data-filter="all"
      >
        Todos
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-full font-medium transition-all cursor-pointer"
        data-filter="fullstack"
      >
        Full Stack
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-full font-medium transition-all cursor-pointer"
        data-filter="frontend"
      >
        Frontend
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-full font-medium transition-all cursor-pointer"
        data-filter="backend"
      >
        Backend
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-full font-medium transition-all cursor-pointer"
        data-filter="diseno"
      >
        Diseño Gráfico
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-full font-medium transition-all cursor-pointer"
        data-filter="realizacion"
      >
        Realización
      </button>
    </nav>

    <!-- ═══════════ PROJECTS GRID ═══════════ -->
    <div
      id="projects-container"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {
        proyectos.map((proyecto, index) => (
          <ProjectCard
            index={index}
            titulo={proyecto.titulo}
            descripcion={proyecto.descripcion}
            imagen={proyecto.imagen}
            tecnologias={proyecto.tecnologias}
            demo={proyecto.demo}
            codigo={proyecto.codigo}
            categoria={proyecto.categoria}
            size={proyecto.size as "large" | "standard"}
            imagePosition={proyecto.imagePosition}
          />
        ))
      }
    </div>

    <!-- ═══════════ LOAD MORE + CTA ═══════════ -->
    <div
      class="mt-16 text-center project-fade-in"
      style="animation-delay: 0.8s;"
    >
      <button
        id="load-more"
        class="group items-center gap-2 px-8 py-3 rounded-full border-2 border-(--color-primary) text-(--color-primary) hover:bg-(--color-primary) hover:text-white transition-all font-bold cursor-pointer"
        style="display: none;"
      >
        Ver más
        <svg
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </button>
    </div>
  </main>

  <!-- ═══════════ DECORATIVE BACKGROUND ═══════════ -->
  <div
    class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none"
  >
    <div
      class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-(--color-primary) opacity-[0.04] rounded-full blur-[100px]"
    >
    </div>
    <div
      class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-(--color-secondary) opacity-[0.04] rounded-full blur-[100px]"
    >
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    /* ---------------- CONFIG ---------------- */
    const VISIBLE_CLASS = "project-visible";
    const HIDDEN_CLASS = "project-hidden";
    const HIDE_TIMEOUT = 300;

    const INITIAL_VISIBLE = 12;
    let itemsToShow = INITIAL_VISIBLE;
    let activeFilter = "all";
    let cards = [];
    let filterButtons = [];
    let loadMoreBtn = null;

    /* ---------------- HELPERS ---------------- */
    function queryElements() {
      cards = Array.from(document.querySelectorAll("[data-index]"));
      filterButtons = Array.from(document.querySelectorAll(".filter-btn"));
      loadMoreBtn = document.getElementById("load-more");
    }

    function showCard(card) {
      card.style.display = "";
      requestAnimationFrame(() => {
        card.classList.remove(HIDDEN_CLASS);
        card.classList.add(VISIBLE_CLASS);
      });
    }

    function hideCard(card) {
      card.classList.remove(VISIBLE_CLASS);
      card.classList.add(HIDDEN_CLASS);
      setTimeout(() => {
        if (card.classList.contains(HIDDEN_CLASS)) {
          card.style.display = "none";
        }
      }, HIDE_TIMEOUT);
    }

    function setActiveButton(btn) {
      filterButtons.forEach((b) => b.classList.remove("active"));
      if (btn) btn.classList.add("active");
    }

    /* ---------------- FILTRADO ---------------- */
    function applyFilter(filter) {
      activeFilter = filter ?? "all";
      const normalized = activeFilter.toLowerCase();

      cards = Array.from(document.querySelectorAll("[data-index]"));

      const filteredCards = cards.filter((card) => {
        const categoria = (card.dataset.categoria ?? "").toLowerCase();
        return normalized === "all" || categoria === normalized;
      });

      cards.forEach((c) => hideCard(c));

      filteredCards.forEach((card, i) => {
        if (i < itemsToShow) showCard(card);
      });

      // botón ver más visible solo si hay más para ver
      if (!loadMoreBtn) return;
      loadMoreBtn.style.display =
        filteredCards.length > itemsToShow ? "inline-flex" : "none";
    }

    /* ---------------- Filtros eventos ---------------- */
    function attachFilterEvents() {
      if (!filterButtons.length) return;
      filterButtons.forEach((btn) => {
        btn.onclick = () => {
          itemsToShow = INITIAL_VISIBLE;
          const filter = btn.dataset.filter || "all";
          setActiveButton(btn);
          applyFilter(filter);
        };
      });

      // activar "Todos" al inicio
      const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
      setActiveButton(allBtn);
    }

    /* ---------------- Ver mas ---------------- */
    function attachLoadMore() {
      if (!loadMoreBtn) return;
      loadMoreBtn.onclick = () => {
        itemsToShow += INITIAL_VISIBLE;
        applyFilter(activeFilter);
      };
    }

    /* ---------------- INIT ---------------- */
    function init() {
      queryElements();
      attachFilterEvents();
      attachLoadMore();

      // Check for ?cat= query param (from service card links)
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get("cat");
      if (catParam) {
        const matchBtn = document.querySelector(
          `.filter-btn[data-filter="${catParam}"]`,
        );
        if (matchBtn) {
          setActiveButton(matchBtn);
          applyFilter(catParam);
          return;
        }
      }
      applyFilter("all");
    }

    document.addEventListener("astro:page-load", init);
    window.addEventListener("load", init);
  })();
</script>
