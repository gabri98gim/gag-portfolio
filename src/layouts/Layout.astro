---
import "../styles/global.css";
import Navbar from "../components/commons/navbar/navbar.astro";
import Footer from "../components/commons/footer/footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Portfolio de Gabriel Andreu Gimeno — Desarrollador Front End & Filmmaker. Proyectos web, diseño y producción audiovisual."
    />
    <title>Gabriel Andreu Gimeno — GAG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <script is:inline>
      // 1. Check localStorage
      // 2. If NO localStorage, default to DARK (User preference)
      // 3. If localStorage says 'dark', be DARK
      // 4. If localStorage says 'light', be LIGHT
      if (
        localStorage.getItem("color-theme") === "dark" ||
        !localStorage.getItem("color-theme")
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
