---
const { titulo } = Astro.props;
---

<section class="pt-28 pb-10 text-center gradient-bg">
  <div class="relative z-10 container mx-auto px-6">
    <div class="flex justify-center mb-4">
      <span class="accent-line"></span>
    </div>
    <h1
      class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white"
    >
      {titulo}
    </h1>
  </div>
</section>
