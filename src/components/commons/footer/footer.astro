---
import { FaLinkedinIn, FaGithub } from "react-icons/fa6";

const socialLinks = [
  {
    href: "https://www.linkedin.com/in/gabriel-andreu-gimeno-ba674824a/",
    icon: FaLinkedinIn,
    label: "LinkedIn",
  },
  { href: "https://github.com/gabri98gim", icon: FaGithub, label: "GitHub" },
];
---

<footer
  class="mt-24 border-t border-(--color-border) bg-(--color-bg-elevated) py-14"
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex flex-col items-center md:items-start">
        <span
          class="text-2xl font-extrabold text-(--color-text) tracking-[-0.05em]"
        >
          GAG<span class="text-(--color-primary)">.</span>
        </span>
        <p class="text-(--color-text-muted) text-sm mt-2 font-medium">
          Filmmaker & Front-End Developer
        </p>
      </div>

      <div class="flex gap-3">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon"
              aria-label={social.label}
            >
              <social.icon className="h-4 w-4" />
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="mt-10 pt-8 border-t border-(--color-border) flex flex-col items-center gap-4"
    >
      <a
        href="mailto:gandreu8@gmail.com"
        class="text-(--color-text-muted) hover:text-(--color-primary) transition-colors text-sm font-medium tracking-wide"
      >
        gandreu8@gmail.com
      </a>
      <p
        class="text-(--color-text-muted) opacity-50 text-[11px] uppercase tracking-[0.2em]"
      >
        © {new Date().getFullYear()} Gabriel Andreu · Crafted with Astro
      </p>
    </div>
  </div>
</footer>
