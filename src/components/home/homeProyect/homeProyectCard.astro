---
export interface Props {
  titulo: string;
  descripcion: string;
  imagen: string;
  tecnologias: string[];
  demo: string;
  codigo: string;
  index: number;
}

const { titulo, descripcion, imagen, tecnologias, demo, codigo } = Astro.props;
---

<div
  class="group relative flex w-full flex-col overflow-hidden rounded-2xl bg-(--color-card) border border-(--color-border) transition-all duration-500 hover:border-(--color-border-hover) hover:shadow-(--shadow-glow)"
>
  <div
    class="aspect-video w-full overflow-hidden border-b border-(--color-border)"
  >
    <img
      src={imagen}
      alt={`Proyecto: ${titulo}`}
      class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
    />
  </div>

  <div class="flex flex-col grow p-7">
    <h3
      class="text-xl font-bold mb-3 text-(--color-text) group-hover:text-(--color-primary) transition-colors"
    >
      {titulo}
    </h3>

    <div class="flex flex-wrap gap-2 mb-4">
      {
        tecnologias.map((tech) => (
          <span class="rounded-lg bg-(--color-primary)/10 border border-(--color-primary)/15 text-(--color-primary) px-2.5 py-1 text-xs font-semibold tracking-wide">
            {tech}
          </span>
        ))
      }
    </div>

    <p
      class="text-(--color-text-muted) text-sm leading-relaxed mb-8 line-clamp-3"
    >
      {descripcion}
    </p>

    <div class="mt-auto flex gap-3">
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary flex-1 py-3 text-sm text-center"
      >
        Live Demo
      </a>

      <a
        href={codigo}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline flex-1 py-3 text-sm text-center"
      >
        GitHub
      </a>
    </div>
  </div>
</div>
