---
import { Image } from "astro:assets";
import PdfThumbnail from "../../project/PdfThumbnail.jsx";

export interface Props {
  titulo: string;
  descripcion: string;
  imagen: any;
  tecnologias: string[];
  demo: string;
  codigo: string;
  index: number;
  imagePosition?: string;
  fit?: "cover" | "contain";
}

const {
  titulo,
  descripcion,
  imagen,
  tecnologias,
  demo,
  codigo,
  imagePosition = "top",
  fit = "cover",
} = Astro.props;

// Logic to determine if asset is a PDF or an external URL
const isPdf =
  typeof imagen === "string" && imagen.toLowerCase().endsWith(".pdf");
const isExternal =
  typeof imagen === "string" &&
  (imagen.startsWith("http") || imagen.startsWith("https"));
---

<div
  class="group relative flex w-full flex-col overflow-hidden rounded-2xl bg-(--color-card) border border-(--color-border) transition-all duration-500 hover:border-(--color-border-hover) hover:shadow-(--shadow-glow)"
>
  <div
    class="aspect-video w-full overflow-hidden border-b border-(--color-border) relative"
  >
    {
      isPdf ? (
        <PdfThumbnail
          client:visible
          pdfUrl={imagen}
          title={titulo}
          position={imagePosition}
          fit={fit}
        />
      ) : isExternal ? (
        <img
          src={imagen}
          alt={`Proyecto: ${titulo}`}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          style={`object-position: ${imagePosition};`}
        />
      ) : (
        <Image
          src={imagen}
          alt={`Proyecto: ${titulo}`}
          width={800}
          height={450}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          style={`object-position: ${imagePosition};`}
        />
      )
    }
  </div>

  <div class="flex flex-col grow p-7">
    <h3
      class="text-xl font-bold mb-3 text-(--color-text) group-hover:text-(--color-primary) transition-colors"
    >
      {titulo}
    </h3>

    <div class="flex flex-wrap gap-2 mb-4">
      {
        tecnologias.map((tech) => (
          <span class="rounded-lg bg-(--color-primary)/10 border border-(--color-primary)/15 text-(--color-primary) px-2.5 py-1 text-xs font-semibold tracking-wide">
            {tech}
          </span>
        ))
      }
    </div>

    <p
      class="text-(--color-text-muted) text-sm leading-relaxed mb-8 line-clamp-3"
    >
      {descripcion}
    </p>

    <div class="mt-auto flex gap-3">
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-(--color-primary) hover:bg-(--color-primary-hover) text-white flex-1 py-3 text-sm text-center rounded-xl font-semibold transition-colors"
      >
        Live Demo
      </a>

      {
        codigo && codigo !== "#" && (
          <a
            href={codigo}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-(--color-border) hover:bg-(--color-bg-elevated) text-(--color-text) flex-1 py-3 text-sm text-center rounded-xl font-semibold transition-colors"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>
</div>
