---
import { proyectos } from "../../../data/projectData.js";
import ProyectCard from "./homeProyectCard.astro";
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="accent-line mx-auto mb-6 block"></span>
      <h2 class="section-title">
        Proyectos <span class="accent">Destacados</span>
      </h2>
      <p class="text-(--color-text-muted) mt-4 max-w-xl mx-auto text-lg">
        Una selección de mis trabajos más recientes
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {
        proyectos
          .slice(0, 3)
          .map((proyecto, index) => <ProyectCard {...proyecto} index={index} />)
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/proyectos"
        class="btn-primary px-10 py-4 text-sm font-bold inline-flex"
      >
        Ver todos los proyectos
      </a>
    </div>
  </div>
</section>
