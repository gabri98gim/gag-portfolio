---
// Mantenemos tu lista de tecnologías con los iconos arreglados
const technologies = [
  { name: "HTML5", path: "html5/html5-original.svg" },
  { name: "CSS3", path: "css3/css3-original.svg" },
  { name: "JavaScript", path: "javascript/javascript-original.svg" },
  { name: "TypeScript", path: "typescript/typescript-original.svg" },
  { name: "React", path: "react/react-original.svg" },
  { name: "Angular", path: "angularjs/angularjs-original.svg" },
  { name: "Astro", path: "astro/astro-original.svg" },
  { name: "Next.js", path: "nextjs/nextjs-original.svg", invert: true },
  { name: "Vite", path: "vitejs/vitejs-original.svg" },
  { name: "Tailwind", path: "tailwindcss/tailwindcss-original.svg" },
  { name: "Node.js", path: "nodejs/nodejs-original.svg" },
  { name: "Git", path: "git/git-original.svg" },
  { name: "WordPress", path: "wordpress/wordpress-plain.svg", invert: true },
  { name: "Python", path: "python/python-original.svg" },
  // Pack Adobe Moderno
  { name: "Photoshop", path: "photoshop/photoshop-original.svg" },
  {
    name: "Illustrator",
    url: "https://upload.wikimedia.org/wikipedia/commons/f/fb/Adobe_Illustrator_CC_icon.svg",
  },
  {
    name: "InDesign",
    url: "https://cdn.worldvectorlogo.com/logos/adobe-indesign-cc-icon.svg",
  },
  {
    name: "Premiere",
    url: "https://upload.wikimedia.org/wikipedia/commons/4/40/Adobe_Premiere_Pro_CC_icon.svg",
  },
  {
    name: "After Effects",
    url: "https://upload.wikimedia.org/wikipedia/commons/c/cb/Adobe_After_Effects_CC_icon.svg",
  },
];

import { FaLinkedinIn, FaGithub } from "react-icons/fa6";
import TypeEfect from "./typeEfect.jsx";
---

<section class="w-full relative overflow-hidden gradient-bg">
  <!-- Decorative grid pattern -->
  <div
    class="absolute inset-0 opacity-[0.03] dark:opacity-[0.04]"
    style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>

  <!-- Extra gradient orb -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-(--color-primary) opacity-[0.03] blur-[150px] pointer-events-none"
  >
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto pt-28 pb-10">
    <!-- Accent line -->
    <div class="flex justify-center mb-8 animate-fade-in">
      <span class="accent-line"></span>
    </div>

    <!-- Main Heading -->
    <h1
      class="text-5xl md:text-7xl lg:text-8xl font-extrabold mb-6 tracking-[-0.04em] leading-[0.95] text-gray-900 dark:text-white animate-fade-in-up"
    >
      Hola! soy <span class="text-(--color-primary)">Gabriel</span>
    </h1>

    <!-- Typewriter -->
    <div
      class="mb-8 h-[60px] flex items-center justify-center animate-fade-in-up delay-200"
    >
      <TypeEfect client:only />
    </div>

    <!-- Subtitle -->
    <p
      class="text-lg md:text-xl text-(--color-text-muted) max-w-2xl mx-auto mb-10 leading-relaxed font-medium animate-fade-in-up delay-300"
    >
      Explora mis proyectos, conoce un poco más sobre mí y, si deseas ponerte en
      contacto, ¡estoy a solo un mensaje de distancia!
    </p>

    <!-- Social Icons -->
    <div class="flex justify-center gap-4 mb-10 animate-fade-in-up delay-400">
      <a
        href="https://www.linkedin.com/in/gabriel-andreu-gimeno-ba674824a/"
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="LinkedIn"
      >
        <FaLinkedinIn className="h-5 w-5" />
      </a>
      <a
        href="https://github.com/gabri98gim"
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="GitHub"
      >
        <FaGithub className="h-5 w-5" />
      </a>
    </div>

    <!-- CTA Buttons -->
    <div
      class="flex justify-center gap-4 flex-wrap animate-fade-in-up delay-500"
    >
      <a
        href="/CV Sector TIC Gabriel Andreu Gimeno 2026.pdf"
        download
        class="btn-primary px-8 py-3.5 text-sm font-bold"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
        Mi Curriculum
      </a>
      <a href="/contact" class="btn-outline px-8 py-3.5 text-sm font-bold">
        Contacto
      </a>
    </div>
  </div>

  <!-- Tech Carousel -->
  <div class="w-full mt-8 mb-12 relative">
    <div
      class="absolute top-0 left-0 z-10 h-full w-40 bg-linear-to-r from-(--color-bg) to-transparent pointer-events-none"
    >
    </div>
    <div
      class="absolute top-0 right-0 z-10 h-full w-40 bg-linear-to-l from-(--color-bg) to-transparent pointer-events-none"
    >
    </div>

    <div class="flex w-max animate-infinite-scroll hover:animate-paused gap-8">
      {
        [...technologies, ...technologies].map((tech) => (
          <div class="flex flex-col items-center gap-3 group cursor-default">
            <div class="h-20 w-20 flex items-center justify-center rounded-2xl bg-(--color-card) border border-(--color-border) backdrop-blur-sm group-hover:border-(--color-primary) group-hover:shadow-(--shadow-glow) group-hover:scale-110 transition-all duration-300">
              <img
                src={
                  tech.url
                    ? tech.url
                    : `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${tech.path}`
                }
                alt={tech.name}
                class={`h-11 w-11 object-contain transition-transform duration-300 ${tech.invert ? "dark:invert-0 invert" : ""}`}
                loading="lazy"
              />
            </div>
            <span class="text-xs font-semibold text-(--color-text-muted) group-hover:text-(--color-primary) transition-colors tracking-wide">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes infinite-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .animate-infinite-scroll {
    animation: infinite-scroll 60s linear infinite;
  }
  .animate-paused {
    animation-play-state: paused;
  }
</style>
