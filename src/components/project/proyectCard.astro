---
import { Image } from "astro:assets";
import PdfThumbnail from "./PdfThumbnail.jsx";

export interface Props {
  titulo: string;
  descripcion: string;
  imagen: any;
  tecnologias: string[];
  demo: string;
  codigo: string;
  categoria?: string;
  index: number;
  size?: "large" | "standard";
  imagePosition?: string;
}

const {
  titulo,
  descripcion,
  imagen,
  tecnologias,
  demo,
  codigo,
  categoria,
  index,
  size = "standard",
  imagePosition,
} = Astro.props;

const isLarge = size === "large";

// Logic to determine if asset is a PDF or an external URL
const isPdf = typeof imagen === "string" && imagen.toLowerCase().endsWith(".pdf");
const isExternal = typeof imagen === "string" && (imagen.startsWith("http") || imagen.startsWith("https"));
---

{isLarge ? (
  <!-- ═══════════ CARD LARGE (2 cols) ═══════════ -->
  <div
    data-index={index}
    data-categoria={categoria ?? ""}
    class="project-card group relative md:col-span-2 rounded-2xl overflow-hidden border border-(--color-border) shadow-xl transition-all duration-300 hover:border-(--color-primary) project-fade-in"
    style={`animation-delay: ${0.15 + index * 0.1}s; min-height: 400px;`}
  >
    <!-- Browser chrome bar -->
    <div class="absolute top-0 left-0 right-0 h-10 bg-(--color-bg-elevated) border-b border-(--color-border) flex items-center px-4 gap-2 z-20">
      <div class="flex gap-1.5">
        <div class="w-3 h-3 rounded-full bg-red-400"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
        <div class="w-3 h-3 rounded-full bg-green-400"></div>
      </div>
      <div class="flex-1 ml-3 bg-(--color-bg) h-6 rounded text-[10px] text-(--color-text-muted) flex items-center px-3 font-mono truncate">
        {demo.replace(/https?:\/\//, '')}
      </div>
    </div>

    <!-- Image / PDF Thumbnail -->
    <div class="absolute inset-0 top-10">
      {isPdf ? (
        <PdfThumbnail client:visible pdfUrl={imagen} title={titulo} />
      ) : isExternal ? (
        <img
          src={imagen}
          alt={`Imagen del proyecto ${titulo}`}
          class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <Image
          src={imagen}
          alt={`Imagen del proyecto ${titulo}`}
          width={1200}
          height={600}
          class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
      )}
    </div>

    <!-- Hover Overlay -->
    <div class="absolute inset-0 bg-linear-to-t from-(--color-bg)/95 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-8 z-30">
      <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
        <!-- Tech tags -->
        <div class="flex gap-2 mb-3 flex-wrap">
          {tecnologias.map((tech) => (
            <span class="px-3 py-1 text-xs font-semibold bg-(--color-primary)/15 text-(--color-primary) border border-(--color-primary)/25 rounded-full backdrop-blur-md">
              {tech}
            </span>
          ))}
        </div>
        <h3 class="text-3xl font-bold text-(--color-text) mb-2">{titulo}</h3>
        <p class="text-(--color-text-muted) mb-6 max-w-lg line-clamp-2">{descripcion}</p>
        <div class="flex items-center gap-4">
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-(--color-primary) hover:bg-(--color-primary-hover) text-white px-6 py-3 rounded-full font-medium transition-colors flex items-center gap-2 group/btn"
          >
            Ver Proyecto
            <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          {codigo && codigo !== "#" && (
            <a
              href={codigo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--color-text-muted) hover:text-(--color-text) transition-colors text-sm font-semibold"
            >
              GitHub →
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
) : (
  <!-- ═══════════ CARD STANDARD (1 col) ═══════════ -->
  <div
    data-index={index}
    data-categoria={categoria ?? ""}
    class="project-card group relative rounded-2xl overflow-hidden border border-(--color-border) shadow-xl transition-all duration-300 hover:border-(--color-primary)/50 project-fade-in flex flex-col"
    style={`animation-delay: ${0.15 + index * 0.1}s;`}
  >
    <!-- Image / PDF — grows to fill available space -->
    <div class="flex-1 min-h-[200px] overflow-hidden relative">
      {isPdf ? (
        <PdfThumbnail client:visible pdfUrl={imagen} title={titulo} />
      ) : isExternal ? (
        <img
          src={imagen}
          alt={`Imagen del proyecto ${titulo}`}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          style={`object-position: ${imagePosition || "top"};`}
          loading="lazy"
        />
      ) : (
        <Image
          src={imagen}
          alt={`Imagen del proyecto ${titulo}`}
          width={600}
          height={400}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          style={`object-position: ${imagePosition || "top"};`}
          loading="lazy"
        />
      )}
    </div>

    <!-- Glass panel sliding up on hover -->
    <div class="absolute inset-x-0 bottom-0 p-4 translate-y-[calc(100%-4.5rem)] group-hover:translate-y-0 transition-transform duration-300 z-20">
      <div class="glass-card rounded-xl p-5 shadow-lg">
        <!-- Always visible row -->
        <div class="flex justify-between items-start mb-1">
          <div>
            <h3 class="text-lg font-bold text-(--color-text)">{titulo}</h3>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {tecnologias.map((tech) => (
                <span class="px-2.5 py-0.5 text-[10px] font-semibold bg-(--color-primary)/15 text-(--color-primary) border border-(--color-primary)/25 rounded-full">
                  {tech}
                </span>
              ))}
            </div>
          </div>
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 bg-(--color-primary) rounded-full text-white shrink-0 hover:bg-(--color-primary-hover) transition-colors"
          >
            <svg class="w-4 h-4 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </a>
        </div>

        <!-- Hidden until hover -->
        <div class="mt-4 pt-4 border-t border-(--color-border) opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
          <p class="text-xs text-(--color-text-muted) line-clamp-2 mb-3">{descripcion}</p>
          <a
            href={codigo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-(--color-primary) uppercase tracking-wider hover:text-(--color-text) transition-colors"
          >
            Ver Código
          </a>
        </div>
      </div>
    </div>
  </div>
)}
