---
import MiFoto from "../../assets/img/MiFoto.png";
import { HiDownload } from "react-icons/hi";

// Nombre exacto de tu archivo en la carpeta public
const cvPath = "/CV Sector TIC Gabriel Andreu Gimeno 2026.pdf";
---

<section class="pt-28 pb-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Text Content -->
      <div class="flex-1 text-center lg:text-left animate-fade-in-up">
        <span
          class="text-xs font-bold tracking-[0.25em] text-(--color-primary) uppercase mb-4 block"
        >
        </span>

        <h1 class="section-title mb-6">
          Gabriel<br />
          <span class="accent">Andreu</span>
          <br />Gimeno
        </h1>

        <div
          class="space-y-4 text-(--color-text-muted) leading-relaxed text-lg max-w-xl"
        >
          <p>
            Un perfil multidisciplinar basado en Zaragoza. Combino precisión
            técnica con visión artística para crear experiencias digitales
            inmersivas. Desde arquitectura web pixel-perfect hasta narrativa
            audiovisual.
          </p>
        </div>

        <div
          class="mt-10 flex flex-col sm:flex-row justify-center lg:justify-start gap-4"
        >
          <a href="/proyectos" class="btn-primary px-8 py-4 text-sm">
            Explorar Servicios
          </a>

          <a href="#experience" class="btn-outline px-8 py-4 text-sm">
            Ver Trayectoria
          </a>
        </div>
      </div>

      <!-- Photo — Full width, no frame -->
      <div
        class="relative shrink-0 w-full max-w-xs lg:max-w-sm animate-fade-in"
        style="animation-delay: 0.2s;"
      >
        <!-- Glow behind photo -->
        <div
          class="absolute -inset-4 bg-linear-to-br from-(--color-primary)/10 to-(--color-secondary)/10 rounded-3xl blur-2xl pointer-events-none"
        >
        </div>
        <img
          src={MiFoto.src}
          alt="Gabriel Andreu"
          class="relative w-full aspect-3/4 object-cover object-[center_15%] rounded-2xl"
        />
      </div>
    </div>
  </div>
</section>
