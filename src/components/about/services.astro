---
/**
 * Professional Services — 3 service cards
 * Matches Stitch design: Desarrollo Web, Diseño Gráfico, Audiovisual
 */
const services = [
  {
    icon: "code",
    titulo: "Desarrollo Web",
    descripcion:
      "Soluciones web robustas y escalables con enfoque en rendimiento y arquitectura moderna.",
    skills: ["React", "Astro", "Tailwind", "TypeScript", "Next.js"],
  },
  {
    icon: "palette",
    titulo: "Diseño Gráfico",
    descripcion:
      "Narrativas visuales impactantes que definen la identidad de marca y conectan con la audiencia.",
    skills: ["Photoshop", "Illustrator", "Figma", "Branding"],
  },
  {
    icon: "videocam",
    titulo: "Audiovisual",
    descripcion:
      "Producción de vídeo de alta calidad, desde la conceptualización hasta el corte final.",
    skills: ["Premiere Pro", "After Effects", "DaVinci", "Guión"],
  },
];
---

<section id="services" class="py-20">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <span class="accent-line mb-4 mx-auto block"></span>
      <h2 class="section-title mb-4">
        Professional <span class="accent">Services</span>
      </h2>
      <p class="text-(--color-text-muted) max-w-2xl mx-auto text-lg">
        Soluciones especializadas para la excelencia digital en tres pilares clave.
      </p>
    </div>

    <!-- Service Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, i) => (
        <div
          class="group relative overflow-hidden rounded-2xl bg-(--color-card) border border-(--color-border) p-8 transition-all duration-400 hover:border-(--color-border-hover) hover:shadow-(--shadow-glow) hover:-translate-y-1 animate-fade-in-up"
          style={`animation-delay: ${0.1 + i * 0.15}s;`}
        >
          <!-- Decorative gradient -->
          <div class="absolute -top-20 -right-20 h-40 w-40 rounded-full bg-(--color-primary) opacity-[0.05] blur-[60px] group-hover:opacity-[0.12] transition-opacity duration-500 pointer-events-none"></div>

          <!-- Icon -->
          <div class="w-14 h-14 rounded-xl bg-(--color-primary)/10 border border-(--color-primary)/20 flex items-center justify-center mb-6 group-hover:bg-(--color-primary)/20 transition-colors duration-300">
            <span class="material-icons text-2xl text-(--color-primary)">{service.icon}</span>
          </div>

          <!-- Content -->
          <h3 class="text-xl font-bold text-(--color-text) mb-3 group-hover:text-(--color-primary) transition-colors">
            {service.titulo}
          </h3>
          <p class="text-(--color-text-muted) leading-relaxed mb-6 text-sm">
            {service.descripcion}
          </p>

          <!-- Skill pills -->
          <div class="flex flex-wrap gap-2">
            {service.skills.map((skill) => (
              <span class="px-3 py-1 text-xs font-semibold bg-(--color-primary)/8 text-(--color-primary) border border-(--color-primary)/15 rounded-full">
                {skill}
              </span>
            ))}
          </div>

          <!-- Hover arrow -->
          <div class="absolute top-8 right-8 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-2 group-hover:translate-x-0">
            <svg class="w-5 h-5 text-(--color-primary)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
